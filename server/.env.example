# OrbitX Server Environment Template
# Clone this to .env and fill in your actual credentials

PORT=4000
FRONTEND_URL=http://localhost:5173
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/orbitx?retryWrites=true&w=majority

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Inngest Background Queue & Jobs
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# ImageKit Media Cloud
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint

# SMTP / Email Notifications
SENDER_EMAIL=your_email@example.com
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_app_password
